{
    "name": "clone-flighty",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "predeploy": "npm run build",
        "deploy": "npx --yes gh-pages -d dist -b gh-pages",
        "test:stats": "node --test tests/flight-statistics.test.mjs",
        "data:refresh": "node scripts/generate-aviation-data.mjs && node scripts/generate-aircraft-data.mjs",
        "data:aircraft": "node scripts/generate-aircraft-data.mjs --refresh",
        "predev": "npm run data:refresh",
        "prebuild": "npm run data:refresh"
    },
    "dependencies": {
        "vue": "^3.5.43",
        "vue-router": "^4.0.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.0",
        "airline-codes": "^1.1.6",
        "airport-data-js": "^4.0.0",
        "sass": "^1.0.0",
        "vite": "^7.0.0"
    }
}
